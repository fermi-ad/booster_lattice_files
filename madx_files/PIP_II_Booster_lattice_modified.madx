! PIP_II_Booster_lattice.madx modified by helper_scripts/lattice_mod.py: do not edit, re-make it.
! New elements: EXTRACTION_KICKER_L2_A, EXTRACTION_KICKER_L2_B, BEX2, EXTRACTION_KICKER_L2_C, EXTRACTION_KICKER_L2_D, BEX3, BEX4, OLDSTYLE_BPM_L3, OLDSTYLE_BPM_U6L, OLDSTYLE_BPM_U7L, OLDSTYLE_BPM_U8L, L1_START (from extra_elements.csv)
! Class changes: EXTRACTION_KICKER_L12_D_CT -> MKS_KICKER
! Kick factors: none; RMATRIX: no
! Misalignments: 11_13_26_MISALIGN_PIP_II.json, 887 elements, overrides 0; record: PIP_II_Booster_lattice_modified_misalign.json
! Output files: <lattice>_Booster_modified_*; PERM_ALIGN_SURVEY survey: yes; TRACK: as in the lattice
title, 'FNAL Booster lattice';

   /**************************************************************************************************/
  /********          This is the MADX file used to calculate Physical Positions              ********/
 /********                   Focused on PIP-II Booster Injection Area                      *********/
/**************************************************************************************************/
option, -echo, warn, -info -debug;
set,  format="20.10f";
setplot, post=1 , rscale= 1.3;
option, RBARC=fALSE; !set as true later
option, verify=true;


  /*****************************************************************************/
 /******  Now, set up for PIP II  energies. ***********************************/
/*****************************************************************************/

KE=0.8;  	! PIP-II 800 MeV injection kinetic energy (in GeV)

KE_INJ=0.8;  	! PIP-II Injection kinetic energy (in GeV) for callibration

KE_EXT=8.0;  	! PIP-II Extraction kinetic energy (in GeV) for callibration

call, file = 'Common_Booster_input.dat'; !overrides input kinetic energy if given
pc = sqrt(( KE+ pmass)*( KE+ pmass)- pmass* pmass);
pc_true = sqrt(( KE_true+ pmass)*( KE_true+ pmass)- pmass* pmass);
pc_INJ = sqrt(( KE_INJ+ pmass)*( KE_INJ+ pmass)- pmass* pmass);
pc_EXT = sqrt(( KE_EXT+ pmass)*( KE_EXT+ pmass)- pmass* pmass);
Brho= pc/ clight *1e9;
PDELTA = pc_true/pc-1;
Brho_INJ= pc_INJ/ clight *1e9;
Brho_EXT= pc_EXT/ clight *1e9;
beam, particle = PROTON, pc= pc;

call, file = 'PIP_II_Booster_injection.dat'; !overrides input kinetic energy if given


  /*****************************************************************************/
 /******  Instance the Individual Magnets *************************************/
/*****************************************************************************/

dir=1;
blengthf	:=    2.889612;       !  physical length (straight length) for F magnet
blengthd	:=    2.889612;       !  physical length (straight length) for D magnet

FMAG_ANG	:=	0.07130059610111027;
DMAG_ANG	:=	0.059599097798464444;

dK1F	:=	-8.06e-3;	! constant dK1/K1 of the F and D magnets, from the pings (studies/optics_correction, 2026-11-06)
dK1D	:=	-6.97e-3;
qsf :=	54.52600681086714e-3*(1+dK1F);
qsd	:=	-57.87867893028609e-3*(1+dK1D);

ssf     :=     -0.01004904189 + ke*(0.01997203802 + ke*(-0.006776746  + ke*(0.0009182440282 - ke*4.293705e-05*0.975174625)));
ssd     :=      -0.03977396698 + ke*(0.00924059345 + ke*(-0.002426120398 + ke*(0.0003023316123 -  ke*1.786963512e-05)));

FMAG        : RBEND,  L = blengthf	, ANGLE = dir*FMAG_ANG, K1 = qsf  , K2 = dir*ssf;
DMAG        : RBEND,  L = blengthd	, ANGLE = dir*DMAG_ANG, K1 = qsd  , K2 = dir*ssd;

blength_BGDS = 1.9602901143400917;
BGDS        : RBEND,  L = blength_BGDS	, ANGLE = dir*DMAG_ANG, K1 = qsd*(blengthd/blength_BGDS)  , K2 = dir*ssd*(blengthd/blength_BGDS);

  /*****************************************************************************/
 /******************* RF Elements *********************************************/
/*****************************************************************************/

RF01        : RFCAVITY,  L = 0	, VOLT=V01, LAG=LAG01, FREQ=FREQ_RF;
RF02        : RFCAVITY,  L = 0	, VOLT=V02, LAG=LAG02, FREQ=FREQ_RF;
RF03        : RFCAVITY,  L = 0	, VOLT=V03, LAG=LAG03, FREQ=FREQ_RF;
RF04        : RFCAVITY,  L = 0	, VOLT=V04, LAG=LAG04, FREQ=FREQ_RF;
RF05        : RFCAVITY,  L = 0	, VOLT=V05, LAG=LAG05, FREQ=FREQ_RF;
RF06        : RFCAVITY,  L = 0	, VOLT=V06, LAG=LAG06, FREQ=FREQ_RF;
RF07        : RFCAVITY,  L = 0	, VOLT=V07, LAG=LAG07, FREQ=FREQ_RF;
RF08        : RFCAVITY,  L = 0	, VOLT=V08, LAG=LAG08, FREQ=FREQ_RF;
RF09        : RFCAVITY,  L = 0	, VOLT=V09, LAG=LAG09, FREQ=FREQ_RF;
RF10        : RFCAVITY,  L = 0	, VOLT=V10, LAG=LAG10, FREQ=FREQ_RF;
RF11        : RFCAVITY,  L = 0	, VOLT=V11, LAG=LAG11, FREQ=FREQ_RF;
RF12        : RFCAVITY,  L = 0	, VOLT=V12, LAG=LAG12, FREQ=FREQ_RF;
RF13        : RFCAVITY,  L = 0	, VOLT=V13, LAG=LAG13, FREQ=FREQ_RF;
RF14        : RFCAVITY,  L = 0	, VOLT=V14, LAG=LAG14, FREQ=FREQ_RF;
RF15        : RFCAVITY,  L = 0	, VOLT=V15, LAG=LAG15, FREQ=FREQ_RF;
RF16        : RFCAVITY,  L = 0	, VOLT=V16, LAG=LAG16, FREQ=FREQ_RF;
RF17        : RFCAVITY,  L = 0	, VOLT=V17, LAG=LAG17, FREQ=FREQ_RF;
RF18        : RFCAVITY,  L = 0	, VOLT=V18, LAG=LAG18, FREQ=FREQ_RF;
RF19        : RFCAVITY,  L = 0	, VOLT=V19, LAG=LAG19, FREQ=FREQ_RF;
RF20        : RFCAVITY,  L = 0	, VOLT=V20, LAG=LAG20, FREQ=FREQ_RF;
RF21        : RFCAVITY,  L = 0	, VOLT=V21, LAG=LAG21, FREQ=FREQ_RF;
RF22        : RFCAVITY,  L = 0	, VOLT=V22, LAG=LAG22, FREQ=FREQ_RF;

  /*****************************************************************************/
 /******  Instance BMA Magnets ************************************************/
/*****************************************************************************/

BMAlength=0.4318;
BMA         : MULTIPOLE;
BMAmag      : INSTRUMENT, L=BMAlength/2.0;
BMAbpm      : MONITOR, L=0.0;

  /*****************************************************************************/
 /********* L3 Extraction Line ************************************************/
/*****************************************************************************/

blength_BGDW = 2.300340440297046;
BGDW        : RBEND,  L = blength_BGDW	, ANGLE = dir*DMAG_ANG, K1 = qsd*(blengthd/blength_BGDW)  , K2 = dir*ssd*(blengthd/blength_BGDW);

  /*****************************************************************************/
 /********* DOGLEG, BEX, MKS Extraction Kicker ********************************/
/*****************************************************************************/

I_DOG = 281.4;
Z_DOG = 0.24722;
THETA_DOG = (0.02344*Brho_INJ/Brho/180)*I_DOG;
L_DOG = Z_DOG*THETA_DOG/SIN(THETA_DOG);

DOG_EDGE  :DIPEDGE, H=SIN(THETA_DOG)/Z_DOG;
DOG_MULT  :MULTIPOLE;
DOG_KICK  :VKICKER, L=0;

KV_MKS = 48.75; !KV per kicker assuming 5 kickers, 4 in L2 and 1 in L12
THETA_MKS = -0.000005273*KV_MKS*MKS_ON*Brho_EXT/Brho;
MKS_KICKER       :VKICKER, KICK=THETA_MKS;

BEX2       :VKICKER, KICK=-0.0000295*I_BEX2*Brho_EXT/Brho;
BEX3       :VKICKER, KICK=-0.0000137*I_BEX3*Brho_EXT/Brho;
BEX4       :VKICKER, KICK=-0.0000295*I_BEX4*Brho_EXT/Brho;

  /*****************************************************************************/
 /********* L11 Injection Line ************************************************/
/*****************************************************************************/

!ORBUMP KICKERS

ORB_KICK_POS        :VKICKER, L = 0, KICK := ORB_KICK_ANG;
ORB_KICK_NEG        :VKICKER, L = 0, KICK := -ORB_KICK_ANG;
!PAINTING KICKERS

!VPML10        :VKICKER, L = 0, KICK := VPML10_ANG*Brho_INJ/Brho;
VPML10        :VKICKER, L = 0, KICK := VPML10_ANG;
!VPML11U        :VKICKER, L = 0, KICK := VPML11U_ANG*Brho_INJ/Brho;
VPML11U        :VKICKER, L = 0, KICK := VPML11U_ANG;
!VPML11D        :VKICKER, L = 0, KICK := VPML11D_ANG*Brho_INJ/Brho;
VPML11D        :VKICKER, L = 0, KICK := VPML11D_ANG;
!VPML12        :VKICKER, L = 0, KICK := VPML12_ANG*Brho_INJ/Brho;
VPML12        :VKICKER, L = 0, KICK := VPML12_ANG;

!HPMS09        :HKICKER, L = 0, KICK := HPMS09_ANG*Brho_INJ/Brho;
HPMS09        :HKICKER, L = 0, KICK := HPMS09_ANG;
!HPMS10        :HKICKER, L = 0, KICK := HPMS10_ANG*Brho_INJ/Brho;
HPMS10        :HKICKER, L = 0, KICK := HPMS10_ANG;
!HPMS11        :HKICKER, L = 0, KICK := HPMS11_ANG*Brho_INJ/Brho;
HPMS11        :HKICKER, L = 0, KICK := HPMS11_ANG;
!HPMS12        :HKICKER, L = 0, KICK := HPMS12_ANG*Brho_INJ/Brho;
HPMS12        :HKICKER, L = 0, KICK := HPMS12_ANG;




PIP_II_BOOSTER_LATTICE        : SEQUENCE,  L = 474.2002212347786, REFER=CENTER;
