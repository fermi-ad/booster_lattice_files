WRITE, FILE='PIP_II_Booster_modified_sectormap.outx', table=SECTORMAP_TABLE;

TRACK, DELTAP=0.0, ONEPASS=FALSE, UPDATE=FALSE, ONETABLE=TRUE, RECLOSS=FALSE, FILE='PIP_II_Booster_modified_track', APERTURE=FALSE;
