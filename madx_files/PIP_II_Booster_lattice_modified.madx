USE, SEQUENCE=PIP_II_BOOSTER_LATTICE;
!TWISS;

/*********** define dispersion correctly (since MADX uses pt, not delta p, as 5th variable) *****/
beta=sqrt(1-1/beam->gamma^2);
dispx:=beta*table(twiss,dx); ! Delta_x=Dispx*Delta_p/p;
dispy:=beta*table(twiss,dy); ! Delta_y=Dispy*Delta_p/p;
/*****************************************************************************/
select, flag = twiss, column=name, s,l,ANGLE,K1L,K2L,y,py,x,px, BETX,BETY,ALFX,ALFY,mux,muy,DX,DPX,DY,DPY,dispx,dispy;

TWISS,DELTAP=PDELTA,SECTORMAP,SECTORTABLE=SECTORMAP_TABLE;
SELECT,FLAG=SECTORMAP_TABLE,COLUMN=name, pos,r11,r12,r21,r22,r33,r34,r43,r44;
WRITE, FILE='PIP_II_Booster_modified_twiss.outx', table=twiss;

SURVEY, SEQUENCE=PIP_II_BOOSTER_LATTICE, FILE='PIP_II_Booster_modified_survey.outx', PERM_ALIGN_SURVEY=FALSE, X0=30260.8945174389, Y0=221.43235981039643, Z0=30457.056766231835, PHI0=3.141592653589793, THETA0=4.057908332126046;
