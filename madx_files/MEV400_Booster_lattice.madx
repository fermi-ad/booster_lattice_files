	BMAS10_MAG_UP: MARKER, AT=473.6229903496744;
	BMAS10: MULTIPOLE, AT=473.8388903496744, KNL={0.0,I_QS10*0.002489/Brho,I_SXS10*2.0*0.045831/Brho}, KSL={0.0,I_SQS10*(0.003924)/Brho,I_SSS10*2.0*0.045477/Brho};
	BMAS10_HV_KICK: KICKER, AT=473.8388903496744, HKICK=I_HS10*0.000366/Brho, VKICK=I_VS10*(-0.000365)/Brho;
	BMAS10_BPM: MONITOR, AT=473.88604154967436;
	BMAS10_MAG_DN: MARKER, AT=474.05479034967436;
	BMAS10_SPOOL_DN: MARKER, AT=474.1986044496744;

ENDSEQUENCE;
USE, SEQUENCE=MEV400_BOOSTER_LATTICE;
!TWISS;

/*********** define dispersion correctly (since MADX uses pt, not delta p, as 5th variable) *****/
beta=sqrt(1-1/beam->gamma^2);
dispx:=beta*table(twiss,dx); ! Delta_x=Dispx*Delta_p/p;
dispy:=beta*table(twiss,dy); ! Delta_y=Dispy*Delta_p/p;
/*****************************************************************************/
select, flag = twiss, column=name, s,l,ANGLE,K1L,K2L,y,py,x,px, BETX,BETY,ALFX,ALFY,mux,muy,DX,DPX,DY,DPY,dispx,dispy;

TWISS,DELTAP=PDELTA,SECTORMAP,SECTORTABLE=SECTORMAP_TABLE;
SELECT,FLAG=SECTORMAP_TABLE,COLUMN=name, pos,r11,r12,r21,r22,r33,r34,r43,r44;
WRITE, FILE='MEV400_Booster_twiss.outx', table=twiss;

SURVEY, SEQUENCE=MEV400_BOOSTER_LATTICE, FILE='MEV400_Booster_survey.outx', PERM_ALIGN_SURVEY=FALSE, X0=30260.8945174389, Y0=221.43235981039643, Z0=30457.056766231835, PHI0=3.141592653589793, THETA0=4.057908332126046;

WRITE, FILE='MEV400_Booster_sectormap.outx', table=SECTORMAP_TABLE;

TRACK, DELTAP=0.0, ONEPASS=FALSE, UPDATE=FALSE, ONETABLE=TRUE, RECLOSS=FALSE, FILE='MEV400_Booster_track', APERTURE=FALSE;
START, X=0.0, PX=0.0, Y=0.0, PY=0.0, T=0.0, PT=0.0;

